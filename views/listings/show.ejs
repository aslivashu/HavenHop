<% layout("/layouts/boilerplate") %>

<div class="container my-3 my-md-4">
  <div class="row justify-content-center">
    <div class="col-12 col-md-10 col-lg-8">
      
       <!-- Details Card -->
      <div class="show-card">
        
        <!-- Hero Image -->
        <div class="show-img-wrapper">
          <img 
            src="<%= listing.image.url %>" 
            class="show-img" 
            alt="<%= listing.title %>"
            onerror="this.onerror=null; this.src='https://i.pinimg.com/1200x/9d/59/d3/9d59d34672b4b139839c530141848210.jpg';"
          >
        </div>

        <!-- Card Content -->
        <div class="show-card-body">
          
          <!-- Header Title & Price -->
          <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 mb-2">
              <h2 class="show-title mb-0 flex-grow-1"><%= listing.title %></h2>
              <div class="show-price text-nowrap">
               ₹<%= listing.price.toLocaleString("en-IN") %>
               <span class="price-period">/ night</span>
              </div>
           </div>
          
          <!-- Owner Display -->
          <p class="text-muted mb-2">
            <i>Owned by <%= listing.owner ? listing.owner.username : "Unknown" %></i>
          </p>

          <!-- Location Badge -->
          <p class="show-location mb-3">
            📍 <%= listing.location %>, <%= listing.country %>
          </p>

          <hr class="show-divider">

          <!-- Description -->
          <div class="show-description mb-4">
            <h5 class="fw-bold mb-2 text-dark fs-6">About this space</h5>
            <p class="text-body-secondary mb-0"><%= listing.description %></p>
          </div>

          <!-- Action Buttons-->
           <% if(currentUser && listing.owner && listing.owner._id && currentUser._id.equals(listing.owner._id)) { %>
          <div class="row g-2 pt-2">
            <div class="col-6">
              <a href="/listings/<%= listing._id %>/edit" class="btn btn-outline-custom w-100 py-2 fw-semibold">
                Edit Listing
              </a>
            </div>
            <div class="col-6">
              <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
                <button type="submit" class="btn btn-danger-custom w-100 py-2 fw-semibold">
                  Delete Listing
                </button>
              </form>
            </div>
          </div>
          <% } %>

          <hr>

          <!-- Reviews Section -->
          <div class="reviews-section">
            <% if (currentUser) { %>
            <div class="review-wrapper">
            <h6>Leave a Review</h6>
            <br>
            <form action="/listings/<%= listing._id %>/reviews" method="POST" class="needs-validation" novalidate>
              <div class="mb-3">
              <label class="d-block ">Rating:</label>
              <fieldset class="starability-heartbeat mb-0">
                  <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked aria-label="No rating." />
                  <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                  <label for="first-rate1" title="Terrible">1 star</label>
                  <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                  <label for="first-rate2" title="Not good">2 stars</label>
                  <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                  <label for="first-rate3" title="Average">3 stars</label>
                  <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                  <label for="first-rate4" title="Very good">4 stars</label>
                  <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                  <label for="first-rate5" title="Amazing">5 stars</label>
                </fieldset>
                
            </div>
             
              <div class="mb-3">
                <label for="comment">Comment:</label>
                <textarea id="comment" name="review[comment]"  placeholder="share your experience" class="form-control" rows="4" required></textarea>
                <div class="invalid-feedback">Please enter a comment.</div>
              </div>
              <button type="submit" class="btn btn-primary">Submit Review</button>
            </form>
            </div>
            <% } else { %>
              <div class="card p-3 bg-light border-0 mb-3 text-center">
                 <p class="text-body-secondary mb-0">
                 Please 
                 <a href="/users/login" 
                 class="text-decoration-none fw-semibold">
                 log in
                 </a> 
                 to leave a review.
                 </p>
              </div>
          <% } %>
        
            <hr>
          
           <!-- Show Reviews -->
            <div class="mt-4">
              <h5>All Reviews</h5>
              <% if(listing.reviews.length === 0) { %>
              <p class="text-body-secondary">No reviews yet. Be the first to leave one!</p>
              <% } else { %>
              <div class="row g-3">
                <% listing.reviews.forEach(review => { %>
                  <div class="col-12 col-md-6">
                    <div class="card review-card h-100 p-3">
                      <div class="user-display"><strong>@<%= review.author.username %></strong></div>
                      <div class="rating-display">  
                        <p class="starability-result" 
                           data-rating="<%= review.rating %>">
                        </p>
                      </div>
                      <div class="comment-display"><%= review.comment %></div>
                      <% if (currentUser && review.author && review.author._id && currentUser._id.equals(review.author._id)) { %>
                      <form class="mb-3" method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                        <button type="submit" class="btn btn-danger-custom w-100 py-2 fw-semibold">Delete</button>
                      </form>
                      <% } %>
                    </div>
                  </div>
                <% }); %>
               </div>
              <% } %>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>