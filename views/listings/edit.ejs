<% layout("/layouts/boilerplate") %>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HopHaven</title>
</head>
<body>
    <h3>Edit this Listing</h3>
    <form method="POST" action="/listings/<%= listing._id %>?_method=PUT">
        <input name="listing[title]" value="<%= listing.title %>" type="text">
        <br><br>
        <textarea name="listing[description]"> <%= listing.description %> </textarea>
        <br><br>
        <input name="listing[image][url]" value="<%= listing.image.url %>" placeholder="enter image URL/Link" type="text">
        <br><br>
        <input name="listing[price]" value="<%= listing.price %>" placeholder="enter price" type="number">
        <br><br>
        <input name="listing[location]" value="<%= listing.location %>" placeholder="enter location" type="text">
        <br><br>
        <input name="listing[country]" value="<%= listing.country %>" placeholder="enter country" type="text">
        <br><br>
        <button type="submit">Update Listing</button>
</body>
</html>