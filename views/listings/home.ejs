<% layout("/layouts/boilerplate") %>

<!-- Hero Section  -->
<div class="container my-4">
    <div class="p-5 mb-5 rounded-4 text-white position-relative overflow-hidden shadow-sm" style="background: linear-gradient(rgba(47, 62, 40, 0.60), rgba(47, 62, 70, 0.55)), url('https://i.pinimg.com/1200x/7c/6c/5c/7c6c5cdb3979e2b4bcbebb538fd1757b.jpg?auto=format&fit=crop&w=1600&q=80') center/cover no-repeat; min-height: 420px; display: flex; flex-direction: column; justify-content: center;">
        <div style="max-width: 600px; z-index: 2;">
            <span class="badge rounded-pill px-3 py-2 mb-3" style="background-color: rgba(0, 166, 167, 0.9); color: #ffffff; font-weight: 600; letter-spacing: 0.5px;">
                THE HAVENHOP EXPERIENCE
            </span>
            <h1 class="display-4 fw-bold mb-3 text-white" style="letter-spacing: -0.03em;">
                Your escape, anywhere you desire.
            </h1>
            <p class="lead mb-4 text-light" style="font-size: 1.1rem; max-width: 550px;">
                Uncover handpicked stays, stunning architectural lofts, quiet beach houses, and breathtaking mountain sanctuaries.
            </p>
            <div class="d-flex flex-wrap gap-3">
                <a href="/listings" class="btn btn-primary-custom btn-lg px-4 py-3 fw-semibold shadow">
                    Start Exploring
                </a>
                <a href="/listings/new" class="btn btn-outline-light btn-lg px-4 py-3 fw-semibold rounded-pill">
                    Host a Haven
                </a>
            </div>
        </div>
    </div>

    <!-- Stats Counter Bar -->
    <div class="row text-center bg-white border rounded-4 p-4 mb-5 shadow-sm" style="border-color: rgba(0,0,0,0.06) !important;">
        <div class="col-md-4 mb-3 mb-md-0">
            <h2 class="fw-bold mb-0" style="color: #00A6A7;">100+</h2>
            <p class="text-muted small mb-0">Unique Stays Worldwide</p>
        </div>
        <div class="col-md-4 mb-3 mb-md-0 border-start border-end">
            <h2 class="fw-bold mb-0" style="color: #00A6A7;">4.8 ★</h2>
            <p class="text-muted small mb-0">Average Guest Rating</p>
        </div>
        <div class="col-md-4">
            <h2 class="fw-bold mb-0" style="color: #00A6A7;">100%</h2>
            <p class="text-muted small mb-0">Verified Property Hosts</p>
        </div>
    </div>



    <!-- Popular Destinations Section -->
    <div class="mb-5">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-2">
            <h3 class="fw-bold m-0" style="color: #2F3E46;">Inspiration for your next trip</h3>
            <a href="/listings" class="text-decoration-none fw-semibold text-nowrap" style="color: #00A6A7;">Explore all locations →</a>
        </div>
        <div class="row g-4">
            <% for(let listing of randomListings) { %>
                <div class="col-lg-3 col-md-6 col-12">
                    <a href="/listings/<%= listing._id %>" class="card-link">
                        <div class="card listing-card h-100 border-0 shadow-sm">
                           <img src="<%= (listing.image && listing.image.url) ? listing.image.url : 'https://i.pinimg.com/1200x/9d/59/d3/9d59d34672b4b139839c530141848210.jpg?auto=format&fit=crop&w=500&q=80' %>" alt="<%= listing.title %>" class="card-img-top">
                            <div class="card-body">
                                <h5 class="fw-bold mb-1 text-dark text-truncate"><%= listing.title %></h5>
                                <p class="text-muted small mb-2"><%= listing.location %>, <%= listing.country %></p>
                                <p class="base-price mb-0"> <%= listing.price.toLocaleString("en-IN") %> <span class="price-night">/ night</span></p>
                            </div>
                        </div>
                    </a>
                </div>
            <% } %>
        </div>
    </div>

    <!-- "How It Works" Section -->
    <div class="mb-5 py-4">
        <h3 class="fw-bold text-center mb-4" style="color: #2F3E46;">How HavenHop Works</h3>
        <div class="row g-4">
            <div class="col-md-4 text-center">
                <div class="p-4 bg-white rounded-4 border h-100 shadow-sm" style="border-color: rgba(0,0,0,0.06) !important;">
                    <div class="fs-1 mb-3">🔍</div>
                    <h5 class="fw-bold mb-2">1. Discover & Choose</h5>
                    <p class="text-muted small mb-0">Browse through handpicked destinations, review property details, and select your ideal vacation spot.</p>
                </div>
            </div>
            <div class="col-md-4 text-center">
                <div class="p-4 bg-white rounded-4 border h-100 shadow-sm" style="border-color: rgba(0,0,0,0.06) !important;">
                    <div class="fs-1 mb-3">⭐</div>
                    <h5 class="fw-bold mb-2">2. Book Safely</h5>
                    <p class="text-muted small mb-0">Read authentic reviews from past guests to plan your travel with total confidence and clarity.</p>
                </div>
            </div>
            <div class="col-md-4 text-center">
                <div class="p-4 bg-white rounded-4 border h-100 shadow-sm" style="border-color: rgba(0,0,0,0.06) !important;">
                    <div class="fs-1 mb-3">✈️</div>
                    <h5 class="fw-bold mb-2">3. Enjoy Your Stay</h5>
                    <p class="text-muted small mb-0">Check-in effortlessly, experience unique spaces, and create wonderful lifelong memories.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Value Proposition Section -->
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="p-4 bg-white rounded-4 border h-100 shadow-sm" style="border-color: rgba(0,0,0,0.06) !important;">
                <div class="p-3 rounded-3 d-inline-block mb-3" style="background-color: rgba(0, 166, 167, 0.08); color: #00A6A7; font-size: 1.4rem;">
                    🏠
                </div>
                <h3 class="h5 fw-bold mb-2">Verified Properties</h3>
                <p class="text-muted mb-0" style="font-size: 0.95rem;">Every listing on HavenHop is verified for quality, comfort, and precise location details so you stay worry-free.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4 bg-white rounded-4 border h-100 shadow-sm" style="border-color: rgba(0,0,0,0.06) !important;">
                <div class="p-3 rounded-3 d-inline-block mb-3" style="background-color: rgba(0, 166, 167, 0.08); color: #00A6A7; font-size: 1.4rem;">
                    💬
                </div>
                <h3 class="h5 fw-bold mb-2">Transparent Reviews</h3>
                <p class="text-muted mb-0" style="font-size: 0.95rem;">Real feedback and ratings left by genuine guests mean you'll always know what to expect before checking in.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4 bg-white rounded-4 border h-100 shadow-sm" style="border-color: rgba(0,0,0,0.06) !important;">
                <div class="p-3 rounded-3 d-inline-block mb-3" style="background-color: rgba(0, 166, 167, 0.08); color: #00A6A7; font-size: 1.4rem;">
                    🛡️
                </div>
                <h3 class="h5 fw-bold mb-2">Seamless Hosting</h3>
                <p class="text-muted mb-0" style="font-size: 0.95rem;">Have an extra space? List your property in minutes, set your own pricing rules, and start welcoming travelers immediately.</p>
            </div>
        </div>
    </div>

    <!--Testimonials -->
    <div class="mb-5">
        <h3 class="fw-bold text-center mb-4" style="color: #2F3E46;">Loved by Hosts & Travelers</h3>
        <div class="row g-4">
            <div class="col-md-6">
                <div class="p-4 bg-white rounded-4 border h-100 shadow-sm" style="border-color: rgba(0,0,0,0.06) !important;">
                    <p class="text-muted fst-italic mb-3">"Listing my vacation property on HavenHop was remarkably straightforward. I had my first booking within a week, and managing the property details through the dashboard is an absolute breeze!"</p>
                    <h6 class="fw-bold mb-0" style="color: #2F3E46;">— Rohan Verma</h6>
                    <span class="text-muted small">Superhost in Goa</span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="p-4 bg-white rounded-4 border h-100 shadow-sm" style="border-color: rgba(0,0,0,0.06) !important;">
                    <p class="text-muted fst-italic mb-3">"Finding unique mountain cottages for weekend getaways used to take forever. HavenHop makes discovery effortless with honest reviews and crystal-clear photos."</p>
                    <h6 class="fw-bold mb-0" style="color: #2F3E46;">— Ananya Sharma</h6>
                    <span class="text-muted small">Frequent Traveler</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Host Call & Banner -->
    <div class="row align-items-center bg-white border rounded-4 p-4 p-md-5 mb-5 shadow-sm" style="border-color: rgba(0,0,0,0.06) !important;">
        <div class="col-lg-7 mb-4 mb-lg-0">
            <h2 class="fw-bold mb-3" style="color: #2F3E46;">Open your door to the world</h2>
            <p class="text-muted mb-4" style="font-size: 1.05rem;">
                Earn extra income and unlock new opportunities by sharing your home, cabin, or guest suite with global travelers looking for unique experiences.
            </p>
            <a href="/listings/new" class="btn btn-primary-custom px-4 py-3 fw-semibold">
                Host a Haven
            </a>
        </div>
        <div class="col-lg-5 text-center">
            <div class="p-4 rounded-4" style="background-color: #F8FAFC; border: 1px dashed #cbd5e1;">
                <h4 class="fw-bold mb-1" style="color: #00A6A7;">Have questions?</h4>
                <p class="text-muted small mb-3">Our hosting dashboard makes tracking inquiries and managing property details completely effortless.</p>
                <a href="/listings" class="text-decoration-none fw-semibold" style="color: #2F3E46;">Browse active listings →</a>
            </div>
        </div>
    </div>

    <!-- Newsletter Signup Banner -->
    <div class="p-5 rounded-4 text-center text-white mb-5 shadow-sm" style="background-color: #2F3E46;">
        <h3 class="fw-bold mb-2 text-white">Get inspired for your next getaway</h3>
        <p class="text-light mb-4" style="max-width: 500px; margin: 0 auto;">Sign up to receive hidden gems, travel tips, and seasonal deals straight to your inbox.</p>
        <div class="d-flex justify-content-center gap-2 mx-auto flex-wrap" style="max-width: 450px;">
            <input type="email" class="form-control rounded-pill px-4 py-2" placeholder="Enter your email address" style="flex: 1;">
            <button type="button" class="btn btn-primary-custom rounded-pill px-4 py-2 text-nowrap fw-semibold">Subscribe</button>
        </div>
    </div>

    <!-- FAQ  Section -->
    <div class="bg-white border rounded-4 p-4 p-md-5 mb-5 shadow-sm" style="border-color: rgba(0,0,0,0.06) !important;">
        <h3 class="fw-bold mb-4 text-center" style="color: #2F3E46;">Frequently Asked Questions</h3>
        <div class="row g-4">
            <div class="col-md-6">
                <h5 class="fw-bold text-dark">How do I book a stay on HavenHop?</h5>
                <p class="text-muted small">Simply browse our active catalog under the "Explore" page, click on any property that catches your eye, review the details and ratings, and coordinate directly or book your stay.</p>
            </div>
            <div class="col-md-6">
                <h5 class="fw-bold text-dark">Is it free to list a property?</h5>
                <p class="text-muted small">Yes! Creating an account and listing your space using the "Host a Haven" button is completely free. You maintain total control over your pricing and calendar.</p>
            </div>
            <div class="col-md-6">
                <h5 class="fw-bold text-dark">Can I leave reviews after checking out?</h5>
                <p class="text-muted small">Absolutely. Verified users can leave star ratings and specific commentary on listings they have experienced to help the community.</p>
            </div>
            <div class="col-md-6">
                <h5 class="fw-bold text-dark">How do I manage or edit my listings?</h5>
                <p class="text-muted small">Once logged into your profile, you can edit or remove your properties through your listing detail views instantly using your owner access permissions.</p>
            </div>
        </div>
    </div>
</div>