<% layout("/layouts/boilerplate") %> 
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HavenHop</title>
</head>
<body>
    
   <!-- Filters & Tax Switch -->
<div id="filters" class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 mb-4 py-2 border-bottom">
    
    <!-- Category Icons-->
    <div class="d-flex gap-4 overflow-auto py-2 w-100" style="scrollbar-width: none; -ms-overflow-style: none; cursor: pointer;">
        <div onclick="filterCategory('All')" class="filter text-decoration-none text-muted text-center flex-shrink-0">
            <div><i class="fa-solid fa-fire"></i></div>
            <p class="small mb-0">Trending</p>
        </div>
        <div onclick="filterCategory('Rooms')" class="filter text-decoration-none text-muted text-center flex-shrink-0">
            <div><i class="fa-solid fa-bed"></i></div>
            <p class="small mb-0">Rooms</p>
        </div>
        <div onclick="filterCategory('Iconic Cities')" class="filter text-decoration-none text-muted text-center flex-shrink-0">
            <div><i class="fa-solid fa-city"></i></div>
            <p class="small mb-0">Iconic Cities</p>
        </div>
        <div onclick="filterCategory('Mountains')" class="filter text-decoration-none text-muted text-center flex-shrink-0">
            <div><i class="fa-solid fa-mountain"></i></div>
            <p class="small mb-0">Mountains</p>
        </div>
        <div onclick="filterCategory('Castles')" class="filter text-decoration-none text-muted text-center flex-shrink-0">
            <div><i class="fa-solid fa-chess-rook"></i></div>
            <p class="small mb-0">Castles</p>
        </div>
        <div onclick="filterCategory('Pools')" class="filter text-decoration-none text-muted text-center flex-shrink-0">
            <div><i class="fa-solid fa-person-swimming"></i></div>
            <p class="small mb-0">Beaches</p>
        </div>
        <div onclick="filterCategory('Camping')" class="filter text-decoration-none text-muted text-center flex-shrink-0">
            <div><i class="fa-solid fa-campground"></i></div>
            <p class="small mb-0">Camping</p>
        </div>
        <div onclick="filterCategory('Farms')" class="filter text-decoration-none text-muted text-center flex-shrink-0">
            <div><i class="fa-solid fa-tractor"></i></div>
            <p class="small mb-0">Farms</p>
        </div>
        <div onclick="filterCategory('Arctic')" class="filter text-decoration-none text-muted text-center flex-shrink-0">
            <div><i class="fa-solid fa-snowflake"></i></div>
            <p class="small mb-0">Arctic</p>
        </div>
        <div onclick="filterCategory('Domes')" class="filter text-decoration-none text-muted text-center flex-shrink-0">
            <div><i class="fa-solid fa-igloo"></i></div>
            <p class="small mb-0">Domes</p>
        </div>
    </div>

    <!-- Tax Switch Toggle -->
    <div class="tax-toggle border rounded-pill px-3 py-2 d-flex align-items-center bg-white shadow-sm align-self-start align-self-lg-center flex-shrink-0 mb-2 mb-lg-0">
        <div class="form-check form-switch form-check-reverse m-0">
            <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckDefault" style="cursor: pointer;">
            <label class="form-check-label small fw-semibold text-dark" for="flexSwitchCheckDefault" style="cursor: pointer;">Display total after taxes</label>
        </div>
    </div>
</div>

    <!-- Heading -->
    <h3 class="mb-4 fw-bold">All Listings</h3>

    <!-- Listings Grid -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4" id="listings-grid">
        <% for (let listing of allListings){ %>
        <div class="col listing-item" data-category="<%= listing.category %>">
            <a href="/listings/<%= listing._id %>" class="card-link"> 
                <div class="card listing-card h-100">
                    <img src="<%= (listing.image && listing.image.url) ? listing.image.url : 'https://i.pinimg.com/1200x/9d/59/d3/9d59d34672b4b139839c530141848210.jpg' %>" 
                    class="card-img-top" 
                    alt="<%= listing.title %>"
                    onerror="this.onerror=null; this.src='https://i.pinimg.com/1200x/9d/59/d3/9d59d34672b4b139839c530141848210.jpg';">
                    <div class="card-body">
                        <p class="card-text">
                            <b><%= listing.title %></b>
                            <br>
                            ₹<span class="base-price" data-price="<%= listing.price %>"><%= listing.price.toLocaleString("en-IN") %></span> 
                            <span class="tax-info" style="display: none;">(incl. 18% GST)</span> / night
                        </p>
                    </div>
                </div>
            </a>
        </div>
        <% } %>
    </div>

    <!-- Empty State Message -->
    <div id="no-listings-msg" class="text-center py-5 my-5" style="display: none; min-height: 40vh;">
        <h4 class="fw-bold text-dark mb-2">No listings found in this category</h4>
        <p class="text-muted mb-4">Try selecting a different category.</p>
    </div>

    <!-- external filter script -->
    <script src="/js/filter.js"></script>
</body>
</html>