<% layout("/layouts/boilerplate") %> 
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HavenHop</title>
</head>
<body>
    <!-- Heading -->
    <h3 class="mb-4 fw-bold">All Listings</h3>

    <!-- Listings Grid -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3">
        <% for (let listing of allListings){ %>

   <!-- Listing Card -->
    <div class="col">
                <a href="/listings/<%= listing._id %>" class="card-link"> 
                    <div class="card listing-card h-100">

                        <!-- Listing Image -->
                        <img src="<%= listing.image.url %>" 
                        class="card-img-top" 
                        alt="<%= listing.title %>"
                        onerror="this.onerror=null; this.src='https://i.pinimg.com/1200x/9d/59/d3/9d59d34672b4b139839c530141848210.jpg';">
        
     <!-- Listing Details -->
     <div class="card-body">
        <p class="card-text">
            <b><%= listing.title %></b>
            <br>
            ₹<%= listing.price.toLocaleString("en-IN") %> / night
        </p>
        </div>
        </div>
        </a>
    </div>
     <% } %>
    </div>
     
    
</body>
</html>