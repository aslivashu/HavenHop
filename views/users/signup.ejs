<% layout("/layouts/boilerplate.ejs") %>

<div class="container my-4 my-md-5">
  <div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
      
      <div class="form-container">
        <h2 class="form-title text-center mb-4">Create Account</h2>
        
        <form action="/users/signup" method="POST" class="needs-validation" novalidate>
          
          <div class="mb-3">
            <label for="username" class="form-label">Username</label>
            <input type="text" id="username" name="username" class="form-control" placeholder="Enter your username" required>
            <div class="invalid-feedback">Please choose a username.</div>
          </div>

          <div class="mb-3">
            <label for="email" class="form-label">Email</label>
            <input type="email" id="email" name="email" class="form-control" placeholder="name@example.com" required>
            <div class="invalid-feedback">Please enter a valid email address.</div>
          </div>

          <div class="mb-4">
            <label for="password" class="form-label">Password</label>
            <input type="password" id="password" name="password" class="form-control" placeholder="Enter your password" required>
            <div class="invalid-feedback">Please enter a password.</div>
          </div>

          <div class="d-grid mb-3">
            <button type="submit" class="btn btn-primary-custom w-100 py-2.5 fw-semibold">Sign Up</button>
          </div>

          <!-- Login Option -->
          <div class="text-center">
            <p class="text-muted mb-0">
              Already have an account? <a href="/users/login" class="text-decoration-none fw-semibold">Log in</a>
            </p>
          </div>

        </form>
      </div>

    </div>
  </div>
</div>