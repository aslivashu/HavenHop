<% if (success && success.length > 0) { %>
  <div class="alert alert-custom-success alert-dismissible fade show" role="alert">
    <div>
      <i class="fa-solid fa-circle-check me-2" style="color: #00A6A7;"></i>
      <%= success %>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>

<%  if (error && error.length > 0) { %>
  <div class="alert alert-custom-error alert-dismissible fade show" role="alert" style="background-color: #FFF5F5; color: #C53030; border: 1.5px solid #FED7D7; border-radius: 16px; padding: 1rem 1.25rem; font-size: 0.95rem; font-weight: 500; box-shadow: 0 4px 16px rgba(229, 62, 62, 0.08);">
    <div>
      <i class="fa-solid fa-circle-exclamation me-2" style="color: #E53E3E;"></i>
      <%= error %>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% } %>